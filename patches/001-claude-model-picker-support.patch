+import { readFileSync } from 'node:fs'
+import { join } from 'node:path'
+
+type ClaudeModelPickerOption = {
+  model: string
+  label?: string
+  description?: string
+}
+
+export type ClaudeModelPickerConfig = {
+  options: readonly ClaudeModelPickerOption[]
+  replaceBuiltInOptions: boolean
+}
+
+type PickerTarget = {
+  id: string
+  label: string
+  description?: string
+  resolvedModel?: string | null
+  efforts: readonly { value: string; label: string }[]
+}
+
+// A malformed or commented settings.json must never fail the listing probe.
+export function readClaudeModelPicker(accountHomePath: string): ClaudeModelPickerConfig | null {
+  try {
+    const parsed: unknown = JSON.parse(readFileSync(join(accountHomePath, 'settings.json'), 'utf8'))
+    const picker =
+      parsed && typeof parsed === 'object' && !Array.isArray(parsed)
+        ? (parsed as Record<string, unknown>).modelPicker
+        : undefined
+    if (!picker || typeof picker !== 'object' || Array.isArray(picker)) {
+      return null
+    }
+    const rawOptions = (picker as Record<string, unknown>).options
+    if (!Array.isArray(rawOptions)) {
+      return null
+    }
+    const options: ClaudeModelPickerOption[] = []
+    for (const entry of rawOptions) {
+      if (!entry || typeof entry !== 'object' || Array.isArray(entry)) {
+        continue
+      }
+      const row = entry as Record<string, unknown>
+      if (typeof row.model !== 'string' || !row.model.trim()) {
+        continue
+      }
+      options.push({
+        model: row.model,
+        ...(typeof row.label === 'string' && row.label.trim() ? { label: row.label } : {}),
+        ...(typeof row.description === 'string' && row.description.trim()
+          ? { description: row.description }
+          : {})
+      })
+    }
+    return options.length === 0
+      ? null
+      : {
+          options,
+          replaceBuiltInOptions: (picker as Record<string, unknown>).replaceBuiltInOptions === true
+        }
+  } catch {
+    return null
+  }
+}
+
+/** Rewrites discovered rows the way the CLI renders a curated modelPicker: option labels win, and
+ *  `replaceBuiltInOptions` drops rows no option names. Matching stays exact because the CLI lists
+ *  each settings alias as its own row keyed by the option's literal model string. */
+export function applyClaudeModelPicker<T extends PickerTarget>(
+  models: readonly T[],
+  picker: ClaudeModelPickerConfig
+): T[] {
+  const matches = (row: PickerTarget, option: ClaudeModelPickerOption): boolean =>
+    row.id === option.model || row.resolvedModel === option.model
+  // Alias rows mirror a canonical row's effort menu even when the CLI omits theirs.
+  const withCanonicalEfforts = (row: T): T => {
+    if (row.efforts.length > 0 || !row.resolvedModel) {
+      return row
+    }
+    const canonical = models.find((candidate) => candidate.id === row.resolvedModel)
+    return canonical ? { ...row, efforts: canonical.efforts } : row
+  }
+  const rename = (row: T, option: ClaudeModelPickerOption): T => ({
+    ...withCanonicalEfforts(row),
+    ...(option.label ? { label: option.label } : {}),
+    ...(option.description ? { description: option.description } : {})
+  })
+  if (!picker.replaceBuiltInOptions) {
+    return models.map((row) => {
+      const option = picker.options.find((candidate) => matches(row, candidate))
+      return option ? rename(row, option) : row
+    })
+  }
+  const rows: T[] = []
+  for (const option of picker.options) {
+    const row = models.find((candidate) => matches(candidate, option))
+    if (row) {
+      rows.push(rename(row, option))
+    }
+  }
+  return rows
+}
