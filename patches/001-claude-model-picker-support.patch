+import { mkdtempSync, rmSync, writeFileSync } from 'node:fs'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { describe, expect, it } from 'vitest'
+
+import { applyClaudeModelPicker, readClaudeModelPicker } from './claude-model-picker-settings'
+
+const PICKER = {
+  options: [
+    { model: 'imported/qiniu/conatus-free[1M]', label: 'qiniu/conatus-free[1M] · 七牛云' },
+    {
+      model: 'deepseek-flash/deepseek-v4.1-flash-1017[1M][1m]',
+      label: 'DeepSeek V4.1 Flash 1017 [1M] · 李尔'
+    },
+    { model: 'deepseek-flash/glm-5.3-flash[1M][1m]', label: 'GLM-5.3-Flash [1M] · 李尔' }
+  ],
+  replaceBuiltInOptions: true
+}
+
+// Probe rows as the CLI lists them: one canonical id plus the settings alias row per model.
+const LISTED = [
+  {
+    id: 'imported/qiniu/conatus-free[1M]',
+    label: 'qiniu/conatus-free[1M] · 七牛云 alias',
+    resolvedModel: 'imported/qiniu/conatus-free[1m]',
+    isDefault: false,
+    efforts: []
+  },
+  {
+    id: 'imported/qiniu/conatus-free[1m]',
+    label: 'Imported Qiniu Conatus Free (1M context)',
+    resolvedModel: 'imported/qiniu/conatus-free[1m]',
+    isDefault: false,
+    efforts: []
+  },
+  {
+    id: 'deepseek-flash/deepseek-v4.1-flash-1017[1M][1m]',
+    label: 'DeepSeek V4.1 Flash 1017 [1M] · 李尔 alias',
+    resolvedModel: 'deepseek-flash/deepseek-v4.1-flash-1017[1m]',
+    isDefault: false,
+    efforts: [{ value: 'high', label: 'High' }]
+  },
+  {
+    id: 'deepseek-flash/deepseek-v4.1-flash-1017[1m]',
+    label: 'Deepseek Flash Deepseek V4.1 Flash 1017 (1M context)',
+    resolvedModel: 'deepseek-flash/deepseek-v4.1-flash-1017[1m]',
+    isDefault: true,
+    efforts: [{ value: 'high', label: 'High' }]
+  },
+  {
+    id: 'deepseek-flash/glm-5.3-flash[1M][1m]',
+    label: 'GLM-5.3-Flash [1M] · 李尔 alias',
+    resolvedModel: 'deepseek-flash/glm-5.3-flash[1m]',
+    isDefault: false,
+    efforts: []
+  },
+  {
+    id: 'deepseek-flash/glm-5.3-flash[1m]',
+    label: 'Deepseek Flash Glm 5.3 Flash (1M context)',
+    resolvedModel: 'deepseek-flash/glm-5.3-flash[1m]',
+    isDefault: false,
+    efforts: [{ value: 'max', label: 'Max' }]
+  }
+]
+
+describe('applyClaudeModelPicker', () => {
+  it('replaces the listing with option rows in option order under option labels', () => {
+    const rows = applyClaudeModelPicker(LISTED, PICKER)
+    expect(rows.map((row) => row.id)).toEqual([
+      'imported/qiniu/conatus-free[1M]',
+      'deepseek-flash/deepseek-v4.1-flash-1017[1M][1m]',
+      'deepseek-flash/glm-5.3-flash[1M][1m]'
+    ])
+    expect(rows.map((row) => row.label)).toEqual([
+      'qiniu/conatus-free[1M] · 七牛云',
+      'DeepSeek V4.1 Flash 1017 [1M] · 李尔',
+      'GLM-5.3-Flash [1M] · 李尔'
+    ])
+    expect(rows[1].efforts).toEqual([{ value: 'high', label: 'High' }])
+    expect(rows[1].isDefault).toBe(false)
+    expect(rows[2].efforts).toEqual([{ value: 'max', label: 'Max' }])
+  })
+
+  it('keeps a canonical row when an option names its id and drops unknown options', () => {
+    const rows = applyClaudeModelPicker([LISTED[3], LISTED[1]], {
+      options: [
+        { model: 'deepseek-flash/deepseek-v4.1-flash-1017[1m]', label: 'DeepSeek · 李尔' },
+        { model: 'unlisted/model', label: 'Unlisted' }
+      ],
+      replaceBuiltInOptions: true
+    })
+    expect(rows).toHaveLength(1)
+    expect(rows[0].id).toBe('deepseek-flash/deepseek-v4.1-flash-1017[1m]')
+    expect(rows[0].label).toBe('DeepSeek · 李尔')
+    expect(rows[0].isDefault).toBe(true)
+  })
+
+  it('keeps every row and only renames option rows when replaceBuiltInOptions is false', () => {
+    const rows = applyClaudeModelPicker(LISTED, { ...PICKER, replaceBuiltInOptions: false })
+    expect(rows).toHaveLength(LISTED.length)
+    expect(rows.map((row) => row.id)).toEqual(LISTED.map((row) => row.id))
+    expect(rows[0].label).toBe('qiniu/conatus-free[1M] · 七牛云')
+    expect(rows[1].label).toBe('Imported Qiniu Conatus Free (1M context)')
+    expect(rows[2].label).toBe('DeepSeek V4.1 Flash 1017 [1M] · 李尔')
+    expect(rows[3].label).toBe('Deepseek Flash Deepseek V4.1 Flash 1017 (1M context)')
+  })
+
+  it('leaves the listing untouched when no option names a listed row', () => {
+    expect(
+      applyClaudeModelPicker(LISTED, {
+        options: [{ model: 'other/model' }],
+        replaceBuiltInOptions: true
+      })
+    ).toEqual([])
+  })
+})
+
+describe('readClaudeModelPicker', () => {
+  it('reads the curated picker from the account settings.json', () => {
+    const home = mkdtempSync(join(tmpdir(), 'orca-picker-home-'))
+    try {
+      writeFileSync(
+        join(home, 'settings.json'),
+        JSON.stringify({
+          modelPicker: {
+            options: [{ model: 'opus', label: 'Opus (daily)' }],
+            replaceBuiltInOptions: true
+          }
+        })
+      )
+      expect(readClaudeModelPicker(home)).toEqual({
+        options: [{ model: 'opus', label: 'Opus (daily)' }],
+        replaceBuiltInOptions: true
+      })
+    } finally {
+      rmSync(home, { recursive: true, force: true })
+    }
+  })
+
+  it('ignores blank labels, malformed rows and unreadable settings', () => {
+    const home = mkdtempSync(join(tmpdir(), 'orca-picker-home-'))
+    try {
+      writeFileSync(
+        join(home, 'settings.json'),
+        JSON.stringify({
+          modelPicker: {
+            options: [
+              { model: '  ', label: 'Broken' },
+              { label: 'No model' },
+              { model: 'haiku', label: '   ' }
+            ],
+            replaceBuiltInOptions: true
+          }
+        })
+      )
+      expect(readClaudeModelPicker(home)).toEqual({
+        options: [{ model: 'haiku' }],
+        replaceBuiltInOptions: true
+      })
+      writeFileSync(join(home, 'settings.json'), '{ not json')
+      expect(readClaudeModelPicker(home)).toBeNull()
+      writeFileSync(join(home, 'settings.json'), JSON.stringify({ model: 'opus' }))
+      expect(readClaudeModelPicker(home)).toBeNull()
+    } finally {
+      rmSync(home, { recursive: true, force: true })
+    }
+  })
+})
