diff --git a/native/windows-agent-hook/build.rs b/native/windows-agent-hook/build.rs
index 297a7ecc180..8cca5c422de 100644
--- a/native/windows-agent-hook/build.rs
+++ b/native/windows-agent-hook/build.rs
@@ -20,6 +20,11 @@ fn main() {
     let (major, minor, patch) = numeric_version_parts(&version);
 
     let mut resource = winresource::WindowsResource::new();
+    // An explicit SDK bin dir (rc.exe's folder) skips the registry lookup, which endpoint
+    // policies can block.
+    if let Ok(toolkit) = env::var("ORCA_WINDOWS_RC_TOOLKIT") {
+        resource.set_toolkit_path(&toolkit);
+    }
     resource.set("ProductName", "Orca");
     resource.set("FileDescription", "Orca Agent Hook");
     resource.set("CompanyName", "Stably AI");
